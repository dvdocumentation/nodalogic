      "record_view": "YandexMap Demo",
      "cover_image": "[[{\"type\":\"Text\",\"value\":\"YandexMap — возможности карты\",\"bold\":true,\"size\":18}],[{\"type\":\"Text\",\"value\":\"Поиск, GPS, точки и маршрутизация\"}]]",
      "init_screen_layout": "[[{\"type\":\"Text\",\"value\":\"YandexMap — интерактивный пример\",\"bold\":true,\"size\":20}],[{\"type\":\"Text\",\"value\":\"Три исходных флажка добавляются программно в onShow, а не хранятся в JSON-разметке карты.\"}],[{\"type\":\"Input\",\"id\":\"search_query\",\"caption\":\"Поиск: кофейня, Парк Горького, адрес…\"}],[{\"type\":\"Button\",\"id\":\"search_button\",\"caption\":\"Найти и отметить флажками\"},{\"type\":\"Button\",\"id\":\"reset_results\",\"caption\":\"Очистить результаты\"}],[{\"type\":\"Button\",\"id\":\"route_all\",\"caption\":\"Построить маршрут: GPS → Физтех → Бауманка → МГУ\"}],[{\"type\":\"Button\",\"id\":\"route_fixed\",\"caption\":\"Тест маршрута без GPS: Физтех → Бауманка → МГУ\"}],[{\"type\":\"Text\",\"value\":\"Статус:\",\"bold\":true}],[{\"type\":\"Text\",\"id\":\"map_status\",\"value\":\"@map_status\"}],[{\"type\":\"YandexMap\",\"id\":\"map\",\"height\":470,\"events\":true,\"route_color\":\"#1565C0\",\"route_width\":7,\"route_debug\":true}],[{\"type\":\"Button\",\"id\":\"center_msu\",\"caption\":\"MapCenter → МГУ (координаты)\"}],[{\"type\":\"Text\",\"value\":\"Тапните по найденному флажку: обработчик object_tap получает широту/долготу и показывает их Toast. Долгий тап ставит оранжевый флаг. GPS-кнопка справа — PlugIn с пользовательским SVG.\"}]]",
      "init_screen_layout_web": "[[{\"type\":\"Text\",\"value\":\"YandexMap is an Android control. Open this demo in NodesClient.\"}]]",
      "data_structure": "Последнее событие|map_event: object\nСтатус|map_status: string\nПоиск|search_query: string\nМаркеры поиска|search_marker_ids: object",
