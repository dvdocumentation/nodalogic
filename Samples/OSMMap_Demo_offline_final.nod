      "init_screen_layout": "[[{\"type\":\"Text\",\"value\":\"OSMMap — офлайновая карта\",\"bold\":true,\"size\":20}],[{\"type\":\"Text\",\"value\":\"Импортируйте MBTiles через главное меню → Офлайновые карты. Пример без маршрутизации и геокодирования.\"}],[{\"type\":\"OSMMap\",\"id\":\"map\",\"height\":310,\"events\":true}],[{\"type\":\"VerticalScroll\",\"id\":\"osm_map_demo_scroll\",\"height\":-1,\"value\":[{\"type\":\"Button\",\"id\":\"prepared_route\",\"caption\":\"Показать готовую полилинию (из бэкенда)\"},{\"type\":\"Button\",\"id\":\"clear_prepared_route\",\"caption\":\"Убрать полилинию\"},{\"type\":\"Button\",\"id\":\"center_msu\",\"caption\":\"Центрировать на МГУ\"},{\"type\":\"Text\",\"value\":\"Долгий тап добавит маркер. Нажмите на маркер — получите его ID.\"}]}]]",
