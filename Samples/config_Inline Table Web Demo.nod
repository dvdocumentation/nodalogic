            "init_screen_layout": "[]",
            "init_screen_layout_web": "[[{\"type\":\"Text\",\"value\":\"Демо веб-клиента: сравните обычные элементы, стандартную таблицу и таблицу с группировкой. Изменения в обычных компонентах не применялись.\"}],[{\"type\":\"Text\",\"value\":\"Обычное размещение элементов формы\"}],[{\"type\":\"Input\",\"id\":\"regular_text\",\"caption\":\"Input\",\"value\":\"@regular_text\"},{\"type\":\"Spinner\",\"id\":\"regular_status\",\"caption\":\"Spinner\",\"value\":\"@regular_status\",\"dataset\":[{\"_id\":\"one\",\"_view\":\"Первый\"},{\"_id\":\"two\",\"_view\":\"Второй\"}]},{\"type\":\"CheckBox\",\"id\":\"regular_check\",\"caption\":\"CheckBox\",\"value\":\"@regular_check\"},{\"type\":\"Switch\",\"id\":\"regular_switch\",\"caption\":\"Switch\",\"value\":\"@regular_switch\"}],[{\"type\":\"NodeInput\",\"id\":\"regular_node\",\"caption\":\"NodeInput\",\"value\":\"@regular_node\",\"dataset\":\"InlineDemoRow\"},{\"type\":\"Reactive\",\"id\":\"regular_reactive\",\"caption\":\"Reactive\",\"default_formula\":\"@regular_number * 2\",\"inline_editable\":true,\"show_caption\":true},{\"type\":\"Button\",\"id\":\"regular_button\",\"caption\":\"Обычная кнопка\"}],[{\"type\":\"Text\",\"value\":\"Обычная плоская таблица — без hierarchy_field и row_layout\"}],[{\"type\":\"Table\",\"id\":\"plain_table\",\"table\":true,\"table_header\":[\"Строка|name|3\",\"Статус|status|2\",\"Активна|active|1\"],\"value\":[{\"name\":\"Обычная строка 1\",\"status\":\"Без изменений\",\"active\":true},{\"name\":\"Обычная строка 2\",\"status\":\"Плоская таблица\",\"active\":false}]}],[{\"type\":\"Text\",\"value\":\"Таблица с группировкой и редакторами в ячейках\"}],[{\"type\":\"Table\",\"id\":\"inline_rows\",\"nodes_source\":true,\"table\":true,\"value\":\"@_inline_demo_refs\",\"table_header\":[\"Статья|name|3\",\"Статус|status|2\",\"Количество|quantity|1\",\"Цена|price|1\",\"Активна|active|1\",\"Связанный узел|related_ref|2\"],\"hierarchy_field\":\"parent_ref\",\"order_field\":\"line_order\",\"add_listener\":\"demo_add_child\",\"add_parent_path\":\"parent_ref\",\"row_layout\":[{\"type\":\"Input\",\"id\":\"name\",\"caption\":\"\",\"value\":\"@name\"},{\"type\":\"Spinner\",\"id\":\"status\",\"caption\":\"\",\"value\":\"@status\",\"dataset\":[{\"_id\":\"Черновик\",\"_view\":\"Черновик\"},{\"_id\":\"План\",\"_view\":\"План\"},{\"_id\":\"Факт\",\"_view\":\"Факт\"}]},{\"type\":\"Input\",\"id\":\"quantity\",\"caption\":\"\",\"value\":\"@quantity\",\"input_type\":\"number\"},{\"type\":\"Reactive\",\"id\":\"price\",\"caption\":\"\",\"default_formula\":\"@quantity * @price\",\"inline_editable\":true,\"show_caption\":false},{\"type\":\"CheckBox\",\"id\":\"active\",\"caption\":\"\",\"value\":\"@active\"},{\"type\":\"NodeInput\",\"id\":\"related_ref\",\"caption\":\"\",\"value\":\"@related_ref\",\"dataset\":\"InlineDemoRow\"}]}],[{\"type\":\"Text\",\"value\":\"Кнопка добавления подчиненной строки находится в действиях строки (⋯).\"}]]",
