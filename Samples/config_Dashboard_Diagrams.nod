    "classes": [
        {
            "name": "Order",
            "section": "Dashboard objects",
            "section_code": "Dashboard objects",
            "has_storage": false,
            "display_name": "Order",
            "record_view": "",
            "cover_image": "[[\"@number\"]]",
            "display_image_web": "",
            "display_image_table": "",
            "init_screen_layout": "[\r\n  [ {\"type\":\"Input\",\"caption\":\"Number\",\"id\":\"number\",\"value\":\"@number\"} ],\r\n  [ {\"type\":\"Input\",\"caption\":\"Title\",\"id\":\"id\",\"value\":\"@id\"} ],\r\n  [ {\"type\":\"Switch\",\"caption\":\"Активный\",\"id\":\"active\",\"value\":\"@active\"} ]\r\n]",
            "init_screen_layout_web": "",
            "data_structure": "Number|number: string\r\nTitle|id: string\r\nАктивный|active: boolean",
            "ngenie_role": "document",
            "ngenie_prompt": "ласс Order представляет заказы клиентов.\r\n\r\nРусские слова «заказ», «заказы», «заказ клиента» и «активные заказы» относятся к классу Order.\r\n\r\nДля запросов об активных заказах выбирай только узлы Order, у которых active == true.\r\n\r\nКогда пользователь спрашивает, чего хотят клиенты или что требуется по заказам:\r\n- основной смысл бери из поля title;\r\n- группируй одинаковые и близкие пожелания;\r\n- не придумывай значения, которых нет в узлах.\r\n\r\nНе используй поля status, sum, amount, price, total и другие поля, если они не объявлены в DataStructure класса Order.\r\nНе придумывай суммы, статусы, средние значения или другие показатели.",
            "ngenie_description": "Заказ клиента. Поле title содержит краткое описание того, что хочет клиент. Поле description содержит дополнительные подробности. Поле active — признак активного заказа.",
            "show_tag_cloud": false,
            "mobile_print_enabled": false,
            "dashboard_enabled": false,
            "dashboard_width": "100",
            "dashboard_top": false,
